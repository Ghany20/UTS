generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Kategori {
  id        Int       @id @default(autoincrement())
  nama      String
  produk    Produk[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Produk {
  id          Int       @id @default(autoincrement())
  nama        String
  harga       Float
  stok        Int
  kategoriId  Int
  kategori    Kategori  @relation(fields: [kategoriId], references: [id])
  supplierId  Int?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  pembelian   Pembelian[]
  penjualan   Penjualan[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Supplier {
  id         Int         @id @default(autoincrement())
  nama       String
  kontak     String?
  produk     Produk[]
  pembelian  Pembelian[] 
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Pembelian {
  id        Int       @id @default(autoincrement())
  produk    Produk    @relation(fields: [produkId], references: [id])
  produkId  Int
  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  supplierId Int
  jumlah    Int
  hargaBeli Float     // Menambahkan kolom hargaBeli
  tanggal   DateTime  @default(now())
}

model Penjualan {
  id        Int       @id @default(autoincrement())
  produk    Produk    @relation(fields: [produkId], references: [id])
  produkId  Int
  jumlah    Int
  tanggal   DateTime  @default(now())
}

